# Makefile.callscope — add compile-time function tracing to a GNU Make project.
#
# Usage in your Makefile (after SRCS is defined):
#
#     CALLSCOPE_DIR ?= callscope
#     include $(CALLSCOPE_DIR)/Makefile.callscope
#
#     instrument: CFLAGS = $(CFLAGS_INSTRUMENT)
#     instrument: $(BINDIR)/$(TARGET).instr
#     $(BINDIR)/$(TARGET).instr: $(OBJS) $(TRACE_OBJ) | $(BINDIR)
#         $(CC) $(CFLAGS_INSTRUMENT) -no-pie -o $@ $(OBJS) $(TRACE_OBJ) $(LDFLAGS)
#
# Expected from the including Makefile:
#   SRCS            source file list (as passed to the compiler)
#   CC, BUILDDIR    compiler and object directory
#   CFLAGS_SYMBOLS  your normal flags with -g (base for CFLAGS_INSTRUMENT)
# Overridable:
#   CALLSCOPE_DIR     where trace.c/trace.h live          (default: callscope)
#   CALLSCOPE_CONFIG  selection config                    (default: ./trace.config)
#   CALLSCOPE         command that prints the flags       (default: callscope)
#
# -no-pie is required at link time: it keeps runtime addresses equal to link
# addresses so `callscope analyze` can feed them to addr2line directly.

CALLSCOPE_DIR     ?= callscope
CALLSCOPE_CONFIG  ?= trace.config
CALLSCOPE         ?= callscope

# CFLAGS_INSTRUMENT = your CFLAGS_SYMBOLS + -finstrument-functions + the
# exclude lists derived from CALLSCOPE_CONFIG and SRCS.
$(eval $(shell $(CALLSCOPE) flags --config $(CALLSCOPE_CONFIG) -- $(SRCS) 2>/dev/null))

TRACE_OBJ = $(BUILDDIR)/callscope_runtime/trace.o

# Instrumentation runtime: compiled WITHOUT -finstrument-functions (via
# CFLAGS_SYMBOLS, not CFLAGS_INSTRUMENT) so the hooks cannot recurse.
$(TRACE_OBJ): $(CALLSCOPE_DIR)/trace.c $(CALLSCOPE_DIR)/trace.h $(CALLSCOPE_DIR)/trace_shm.h | $(BUILDDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS_SYMBOLS) -c -o $@ $<
