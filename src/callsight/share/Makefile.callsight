# Makefile.callsight — add compile-time function tracing to a GNU Make project.
#
# Usage in your Makefile (after SRCS is defined):
#
#     CALLSIGHT_DIR ?= callsight
#     include $(CALLSIGHT_DIR)/Makefile.callsight
#
#     instrument: CFLAGS = $(CFLAGS_INSTRUMENT)
#     instrument: $(BINDIR)/$(TARGET).instr
#     $(BINDIR)/$(TARGET).instr: $(OBJS) $(TRACE_OBJ) | $(BINDIR)
#         $(CC) $(CFLAGS_INSTRUMENT) -no-pie -o $@ $(OBJS) $(TRACE_OBJ) $(LDFLAGS)
#
# Expected from the including Makefile:
#   SRCS            source file list (as passed to the compiler)
#   CC, BUILDDIR    compiler and object directory
#   CFLAGS_SYMBOLS  your normal flags with -g (base for CFLAGS_INSTRUMENT)
# Overridable:
#   CALLSIGHT_DIR     where trace.c/trace.h live          (default: callsight)
#   CALLSIGHT_CONFIG  selection config                    (default: ./trace.config)
#   CALLSIGHT         command that prints the flags       (default: callsight)
#
# -no-pie is required at link time: it keeps runtime addresses equal to link
# addresses so `callsight analyze` can feed them to addr2line directly.

CALLSIGHT_DIR     ?= callsight
CALLSIGHT_CONFIG  ?= trace.config
CALLSIGHT         ?= callsight

# CFLAGS_INSTRUMENT = your CFLAGS_SYMBOLS + -finstrument-functions + the
# exclude lists derived from CALLSIGHT_CONFIG and SRCS.
$(eval $(shell $(CALLSIGHT) flags --config $(CALLSIGHT_CONFIG) -- $(SRCS) 2>/dev/null))

TRACE_OBJ = $(BUILDDIR)/callsight_runtime/trace.o

# Instrumentation runtime: compiled WITHOUT -finstrument-functions (via
# CFLAGS_SYMBOLS, not CFLAGS_INSTRUMENT) so the hooks cannot recurse.
$(TRACE_OBJ): $(CALLSIGHT_DIR)/trace.c $(CALLSIGHT_DIR)/trace.h $(CALLSIGHT_DIR)/trace_shm.h | $(BUILDDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS_SYMBOLS) -c -o $@ $<
