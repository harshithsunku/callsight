# Makefile.callsight — add compile-time function tracing to a GNU Make project.
#
# Usage in your Makefile (after SRCS is defined):
#
#     CALLSIGHT_DIR ?= callsight
#     include $(CALLSIGHT_DIR)/Makefile.callsight
#
#     instrument: CFLAGS = $(CFLAGS_INSTRUMENT)
#     instrument: $(BINDIR)/$(TARGET).instr
#     $(BINDIR)/$(TARGET).instr: $(OBJS) $(TRACE_OBJ) | $(BINDIR)
#         $(CC) $(CFLAGS_INSTRUMENT) -o $@ $(OBJS) $(TRACE_OBJ) $(LDFLAGS)
#
# Expected from the including Makefile:
#   SRCS            source file list (as passed to the compiler)
#   CC, BUILDDIR    compiler and object directory
#   CFLAGS_SYMBOLS  your normal flags with -g (base for CFLAGS_INSTRUMENT)
# Overridable:
#   CALLSIGHT_DIR     where trace.c/trace.h live          (default: callsight)
#   CALLSIGHT_CONFIG  selection config                    (default: ./trace.config)
#   CALLSIGHT         command that prints the flags       (default: callsight)
#
# -no-pie is NOT required. The runtime records the PIE load bias in every
# trace header and `callsight analyze` subtracts it, so a position-independent
# executable resolves symbols correctly. Link however you ship: forcing
# -no-pie would have you profiling a binary built differently from the real
# one.

CALLSIGHT_DIR     ?= callsight
CALLSIGHT_CONFIG  ?= trace.config
CALLSIGHT         ?= callsight

# CFLAGS_INSTRUMENT = your CFLAGS_SYMBOLS + -finstrument-functions + the
# exclude lists derived from CALLSIGHT_CONFIG and SRCS.
#
# --compiler-cmd lets callsight check the toolchain: the exclude lists are
# GCC-only, so a selective config built with clang is reported here instead
# of failing with an opaque driver error on every file. Diagnostics go to
# stderr and are left visible on purpose.
$(eval $(shell $(CALLSIGHT) flags --config $(CALLSIGHT_CONFIG) \
	--compiler-cmd '$(CC)' -- $(SRCS)))

# Stop only when an instrumented build was actually requested: a project
# that includes this fragment unconditionally must still build normally on a
# machine without callsight installed.
ifneq ($(filter instrument,$(MAKECMDGOALS)),)
ifeq ($(CFLAGS_INSTRUMENT),)
$(error callsight: no instrumentation flags generated — see the message \
above; re-run '$(CALLSIGHT) flags --config $(CALLSIGHT_CONFIG) -- $$(SRCS)' \
for the full diagnostic)
endif
endif

TRACE_OBJ = $(BUILDDIR)/callsight_runtime/trace.o

# Instrumentation runtime: compiled WITHOUT -finstrument-functions (via
# CFLAGS_SYMBOLS, not CFLAGS_INSTRUMENT) so the hooks cannot recurse.
$(TRACE_OBJ): $(CALLSIGHT_DIR)/trace.c $(CALLSIGHT_DIR)/trace.h $(CALLSIGHT_DIR)/trace_shm.h | $(BUILDDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS_SYMBOLS) -c -o $@ $<
